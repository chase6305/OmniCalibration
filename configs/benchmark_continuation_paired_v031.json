        "trim_fraction": 0.1,
        "depth_noise": {
          "sigma_m": 0.0002,
          "scale_bias": 0.005,
          "outlier_fraction": 0.05,
          "outlier_sigma_m": 0.03
        },
        "solver_options": {
          "trim_start_iteration": 2,
          "uncertainty_step_fraction": 0.05,
